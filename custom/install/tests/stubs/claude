#!/bin/bash
# Test stub. Never prints the keychain token; `setup-token` prints a fake secret to its stdout on purpose
# so tests can prove the installer keeps that stream away from its own output and log.
printf 'claude %s(cwd=%s)\n' "$(printf '%s ' "$@" | tr '\n' ' ')" "$PWD" >> "$STUB_LOG"
printf '%s\0' "$@" > "$STUB_LOG.claude.argv"
# Names of the variables carrying the stub Keychain secret, besides the one the installer hands the headless claude.
held=""
for var in $(compgen -e); do
  if [ "$var" = CLAUDE_CODE_OAUTH_TOKEN ] && [ "${1:-}" = -p ]; then continue; fi
  case "${!var}" in *FAKE-SECRET-123*) held="$held $var" ;; esac
done
[ -z "$held" ] || echo "secret-env claude$held" >> "$STUB_LOG"
case "${1:-}" in
  setup-token) echo "FAKE-SECRET-123"; exit "${FAKE_CLAUDE_SETUP_TOKEN_EXIT:-0}" ;;
  --version)
    # The environment a version probe got: the autoupdater setting and the non-empty credential names it inherited, never values.
    creds=""
    for var in $(compgen -e); do case "$var" in ANTHROPIC_* | CLAUDE_CODE_*_TOKEN* | CLAUDE_CODE_*_KEY* | CLAUDE_CODE_*_CERT* | CLAUDE_CODE_*HEADER*) [ -z "${!var}" ] || creds="$creds $var" ;; esac; done
    echo "claude-version-env DISABLE_AUTOUPDATER=${DISABLE_AUTOUPDATER-} creds=${creds# }" >> "$STUB_LOG"
    # FAKE_CLAUDE_LATER_VERSION: what an update in place reports, from the --version call after FAKE_CLAUDE_LATER_AFTER.
    asked=$(grep -c '^claude --version ' "$STUB_LOG")
    if [ -n "${FAKE_CLAUDE_LATER_VERSION:-}" ] && [ "$asked" -gt "${FAKE_CLAUDE_LATER_AFTER:-0}" ]; then echo "$FAKE_CLAUDE_LATER_VERSION (Claude Code)"; exit 0; fi
    echo "${FAKE_CLAUDE_VERSION:-2.1.289} (Claude Code)"; exit 0 ;;
esac
if [ "${1:-}" = "-p" ]; then
  echo "claude-bin $0 DISABLE_AUTOUPDATER=${DISABLE_AUTOUPDATER-}" >> "$STUB_LOG"
  echo "claude-env TOKEN_SET=${CLAUDE_CODE_OAUTH_TOKEN:+1} API_KEY_EMPTY=$([ -z "${ANTHROPIC_API_KEY-x}" ] && echo 1) SUBPROCESS_ENV_SCRUB=${CLAUDE_CODE_SUBPROCESS_ENV_SCRUB-}" >> "$STUB_LOG"
  # Credential names only, never values, besides the two the installer sets on purpose.
  inherited=""
  for var in $(compgen -e); do
    case "$var" in ANTHROPIC_API_KEY | CLAUDE_CODE_OAUTH_TOKEN) continue ;; ANTHROPIC_* | CLAUDE_CODE_*) inherited="$inherited $var" ;; esac
  done
  echo "claude-inherited${inherited}" >> "$STUB_LOG"
  # The token's length only, never its value: the installer must pass it trimmed.
  echo "claude-token-len ${#CLAUDE_CODE_OAUTH_TOKEN}" >> "$STUB_LOG"
  prev=""
  for a in "$@"; do
    if [ "$prev" = "--add-dir" ] && [ -z "${draft:-}" ]; then draft="$a"; fi
    prev="$a"
  done
  if [ -n "${FAKE_CLAUDE_DRAFTS:-}" ] && [ -n "${draft:-}" ]; then
    mkdir -p "$draft"; echo "- stub question" > "$draft/questions.md"
  fi
  echo "stub headless run finished"
  exit "${FAKE_CLAUDE_P_EXIT:-0}"
fi
exit 0
