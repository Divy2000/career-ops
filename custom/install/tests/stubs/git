#!/bin/bash
# Test stub: records argv and fakes just the git calls install.sh makes.
echo "git $*" >> "$STUB_LOG"
dir=""
if [ "${1:-}" = "-C" ]; then dir="$2"; shift 2; fi
# FAKE_GIT_FAIL=<subcommand> makes that subcommand fail, as offline or with a pull that cannot fast-forward.
if [ -n "${FAKE_GIT_FAIL:-}" ] && [ "${1:-}" = "$FAKE_GIT_FAIL" ]; then echo "fatal: unable to access 'https://github.com/': Could not resolve host (stub)" >&2; exit 128; fi
case "${1:-}" in
  clone)
    shift
    url="${@: -2:1}"; target="${@: -1}"
    mkdir -p "$target"
    cp -R "$FAKE_SRC/." "$target/"
    mkdir -p "$target/.git"
    printf '%s\n' "$url" > "$target/.git/origin-url"
    ;;
  remote)
    case "${2:-}" in
      get-url)
        f="$dir/.git/remote-$3"
        [ "$3" = origin ] && f="$dir/.git/origin-url"
        [ -f "$f" ] && cat "$f" || exit 2
        ;;
      add) printf '%s\n' "$4" > "$dir/.git/remote-$3" ;;
    esac
    ;;
  # Each answers only to the exact flags install.sh passes, the way real git does, so dropping one turns a test red:
  # status without --porcelain prints its long form even on a clean tree, rev-parse HEAD without --abbrev-ref prints a
  # commit id, and ls-files without --error-unmatch exits 0 for a file git does not track.
  status)
    if [ "${2:-}" = --porcelain ]; then cat "$dir/.git/dirty" 2>/dev/null || true
    else echo "On branch main"; echo "nothing to commit, working tree clean"; fi
    ;;
  rev-parse)
    if [ "${2:-}" = --abbrev-ref ] && [ "${3:-}" = HEAD ]; then cat "$dir/.git/branch" 2>/dev/null || echo main
    else echo 0123456789abcdef0123456789abcdef01234567; fi
    ;;
  ls-files)
    if [ "${2:-}" = --error-unmatch ]; then [ -f "$dir/.git/lock-tracked" ]; exit $?; fi
    exit 0
    ;;
  fetch|pull|checkout) exit 0 ;;
esac
exit 0
