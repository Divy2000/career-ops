{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "composite": false,
    "incremental": false,
    "types": ["vite/client"],
    "paths": {
      "@shared/*": ["./shared/*"],
      "@web/*": ["./web/*"]
    }
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "shared/**/*.ts", "tests/web/**/*.ts", "tests/web/**/*.tsx"]
}
