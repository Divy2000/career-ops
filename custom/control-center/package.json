{
  "name": "career-ops-control-center",
  "private": true,
  "version": "0.1.0",
  "description": "Local dark-mode control center for career-ops (fork add-on under custom/)",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "start": "tsx supervisor/index.ts",
    "start:built": "tsx supervisor/index.ts --built",
    "build": "vite build && npm run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "lint": "eslint . && node scripts/no-em-dash.mjs",
    "derive:modes": "tsx scripts/derive-mode-policies.ts",
    "probe:claude": "node scripts/claude-probe.mjs",
    "probe:reads": "node scripts/claude-probe-reads.mjs",
    "preflight": "tsx supervisor/preflight-cli.ts",
    "mutate": "stryker run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/middie": "^9.3.4",
    "@fastify/static": "^10.1.5",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "chokidar": "^5.0.0",
    "cmdk": "^1.1.1",
    "diff": "^9.0.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "unified": "^11.0.5",
    "vite": "^8.3.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/diff": "^7.0.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  }
}
